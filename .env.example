# ฐานข้อมูล (ในเครื่อง: docker compose up -d  |  หรือใช้ MongoDB Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/agriculture-office-booking)
MONGODB_URI=mongodb://127.0.0.1:27017/agriculture-office-booking
# ถ้าใช้ Atlas แล้ว DNS ของ Node resolve SRV ไม่ได้ ให้กำหนด DNS server เช่น 8.8.8.8,8.8.4.4
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# คีย์เซ็น session (อย่างน้อย 16 ตัวอักษร, จำเป็นเมื่อรันโหมด production)
# สร้างได้ด้วย: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ผู้ดูแลระบบคนแรก (สร้างให้อัตโนมัติเมื่อยังไม่มีผู้ใช้ในระบบ) — เปลี่ยนรหัสผ่านหลังเข้าสู่ระบบครั้งแรก
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
